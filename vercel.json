{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["sin1"],
  "functions": {
    "src/app/api/queues/reminders/route.ts": {
      "experimentalTriggers": [{ "type": "queue/v2beta", "topic": "reminders", "maxDeliveries": 6, "retryAfterSeconds": 60 }]
    }
  },
  "crons": [{ "path": "/api/cron/reconcile", "schedule": "0 1 * * *" }],
  "schedules": {
    "reminder-sweeper": { "schedule": "*/15 * * * *", "path": "/api/cron/reconcile", "requestMethod": "GET" }
  }
}
