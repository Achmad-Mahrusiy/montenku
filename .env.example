# Database
# Lokal (Supabase CLI): keduanya sama.
# Produksi (Supabase cloud): DATABASE_URL = transaction pooler (port 6543) untuk app,
# DIRECT_URL = koneksi direct/session (port 5432) khusus migrasi.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Better Auth
# Buat secret dengan: npx auth@latest secret
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Upstash Redis untuk rate limit (diisi di Langkah 5)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=