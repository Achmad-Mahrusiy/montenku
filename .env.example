# Database (Supabase cloud > tombol Connect)
# DATABASE_URL = Transaction pooler (port 6543), dipakai app.
# DIRECT_URL   = Session pooler (port 5432), khusus migrasi.
# Test TIDAK memakai ini; test memakai Postgres lokal sementara (lihat vitest.config.mts).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Better Auth
# Buat secret dengan: npx auth@latest secret
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Upstash Redis untuk rate limit (upstash.com > Redis > database > bagian REST API).
# Boleh kosong di laptop: rate limit mati dan muncul peringatan. Wajib diisi di production (Vercel).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Email pengingat lewat Resend (resend.com > API Keys). Tanpa domain sendiri, EMAIL_FROM tetap
# onboarding@resend.dev dan Resend hanya mengirim ke email pemilik akun Resend.
# Kosong di laptop: pengingat tercatat gagal ("RESEND_API_KEY belum diisi"). Wajib diisi di production.
RESEND_API_KEY=
EMAIL_FROM=Montenku <onboarding@resend.dev>

# Rahasia untuk /api/cron/reconcile (cron harian dan penyapu 15 menit), minimal 16 karakter.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Wajib diisi di production.
CRON_SECRET=

# Web Push (Fase 6). Buat sepasang kunci sekali saja dengan: npx web-push generate-vapid-keys
# VAPID_SUBJECT: alamat kontak untuk layanan push, mis. mailto:kamu@example.com.
# Kosong di laptop: pengingat push tercatat gagal ("VAPID belum diisi"). Wajib diisi di production.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
