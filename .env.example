# Database (Supabase cloud > tombol Connect)
# DATABASE_URL = Transaction pooler (port 6543), dipakai app.
# DIRECT_URL   = Session pooler (port 5432), khusus migrasi.
# Test TIDAK memakai ini; test memakai PGlite di memori (lihat vitest.config.mts).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Better Auth
# Buat secret dengan: npx auth@latest secret
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Upstash Redis untuk rate limit (diisi di Langkah 5)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=